# Use a long random alphanumeric password to avoid URL-encoding issues.
POSTGRES_PASSWORD=replace_with_a_long_random_alphanumeric_password
APP_ORIGIN=http://localhost:8080
COOKIE_SECURE=false

# Scanner runs separately; interval is measured after each completed scan.
CATALOG_SCAN_INTERVAL_HOURS=24
# Used by the alert query in the next increment; history is retained independently.
CHANGE_ALERT_WINDOW_DAYS=7
